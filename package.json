    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1",
    "three": "~0.170.0",
    "gsap": "^3.13.0",
    "lenis": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
