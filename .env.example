# ── Required ─────────────────────────────────────────────
# SQLite needs no setup. For Postgres, change the provider in
# prisma/schema.prisma and point this at your database.
DATABASE_URL="file:./dev.db"

# Public URL of the deployed site — used in emails, the sitemap, and the
# private preview links an editor hands out. Set ONE of these; the
# NEXT_PUBLIC one is also readable by the browser bundle and wins.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL=""

# Session signing secret — set a long random string in production
JWT_SECRET=""

# First-boot admin password (12+ chars). REQUIRED when NODE_ENV=production —
# Docker/VPS boots refuse to seed the admin account without it. Local dev
# falls back to admin1234. The account name is owner@<your business domain>.
ADMIN_PASSWORD=""

# ── Shared rate limiting (optional, but read this) ───────
# Without these, the rate limit on public forms and logins is counted in
# the memory of ONE instance. On a platform that runs several (Vercel does),
# an attacker gets the limit times the number of instances and nothing says
# so. Set both and every instance counts in the same place.
# Works with Upstash Redis or Vercel KV — same REST protocol, either pair.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Payments (optional — mock mode without these) ────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# No webhook secret: this site confirms a charge by RETRIEVING the payment
# intent before it writes the order (lib/payments.ts verifyIntent), so there is
# no webhook endpoint to point Stripe at. Adding one in the Stripe dashboard
# would just log delivery failures.
#
# Platform mode only (the studio collects and forwards): the two keys above are
# then the PLATFORM account, and money is routed to this merchant here.
STRIPE_CONNECT_ACCOUNT_ID=""
# fee kept by the platform, in basis points — 150 = 1.5%
STRIPE_APPLICATION_FEE_BP=""

# In-store card reader (Stripe Terminal). Without it the POS card button
# SIMULATES the charge — the sale is recorded as MOCK and no money moves.
# Register a reader in the Stripe dashboard (Terminal → Locations → Readers)
# and paste its tmr_… id here. Only internet-connected smart readers work:
# the charge is driven from the server, so no app runs in the shop.
STRIPE_TERMINAL_READER_ID=""

# ── Email (optional — logged to DB without this) ─────────
# https://resend.com/api-keys
RESEND_API_KEY=""
# On-site AI concierge (answers menu/hours questions from your own data) — optional
ANTHROPIC_API_KEY=""
EMAIL_FROM="orders@yourdomain.com"

# ── SMS (optional — logged to DB without these) ──────────
# https://console.twilio.com — Account SID, Auth Token, and your
# Twilio phone number (E.164, e.g. +15551234567)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Scheduled jobs ────────────────────────────────────────
# vercel.json already schedules the jobs this site can run; Vercel calls them
# with `Authorization: Bearer $CRON_SECRET`. Deploying from LocalSite Studio
# sets this for you. Set it yourself if you deploy by hand, or every run 401s
# and day-before reminders silently never send.
CRON_SECRET=""

# ── Google Maps embed (optional — link card without it) ──
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
